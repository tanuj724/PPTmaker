# =============================================================
# PPTmaker - API Keys Configuration
# Copy to `.env` and fill in your real keys.
# get_api_key(); just edit this file.
# =============================================================

# ---------- REQUIRED (Core Agent Framework) ----------
# Google Gemini API - powers the orchestrator/content/theme agents
# Get it: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---------- HIGHLY RECOMMENDED (Image Curation Phase) ----------
# Unsplash API - high-quality conceptual/business/sports photography
# Get it (free 50 req/hr): https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Pexels API - authentic action/lifestyle/people photography
# Get it (free 200 req/hr): https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ---------- OPTIONAL (Enhanced Research Phase) ----------
# Brave Search API - real-time web search for the Research Agent
# Get it (free 2000 req/month): https://brave.com/search/api/
BRAVE_API_KEY=your_brave_search_api_key_here

# ---------- OPTIONAL (Advanced) ----------
# Toolhouse / SerpAPI for additional web search capacity
# SERPAPI_KEY=your_serpapi_key_here