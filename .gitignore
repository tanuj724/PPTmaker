# ==========================================
# PPTmaker - .gitignore Configuration
# ==========================================

# --- Secrets & Environment Variables ---
.env
.env.local
.env.*
!.env.example

# --- Generated Presentations & Final Output ---
*.pptx
*.ppt
*.pdf
*.key
output/
exports/

# --- Downloaded & Curated Media / Image Assets ---
assets/
assets_*/
unsplash/
media/
images/
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.svg
*.ico

# --- Topic-Specific Build & Download Scripts ---
build_*.py
download_*.py

# --- Ephemeral Agent Research, Specs & Intermediate Artifacts ---
research_json/
runs/
temp/
tmp/
*.tmp

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
myvenv/
env/
ENV/
build/
dist/
*.egg-info/
.eggs/

# --- Logs & Debugging ---
*.log
npm-debug.log*
yarn-debug.log*

# --- Testing & Type Checking ---
.pytest_cache/
.mypy_cache/
.coverage
coverage/
htmlcov/

# --- Editor & IDE Files ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- OS System Files ---
.DS_Store
Thumbs.db
desktop.ini
